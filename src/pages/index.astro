---
import { getCollection } from 'astro:content';
import Badge from '../components/Badge.astro';
import Base from '../layouts/Base.astro';
import { getSongs, fmtDate } from '../lib/songs';

const songs = await getSongs();
const latestSongs = [...songs].sort(
  (first, second) => +second.data.releaseDate - +first.data.releaseDate,
);
const latest = latestSongs[0];
const recentSongs = latestSongs.slice(0, 6);
const events = (await getCollection('events')).map(event => event.data);
const today = new Date();
today.setHours(0, 0, 0, 0);
const next = events
  .filter(event => new Date(`${event.date.slice(0, 10)}T00:00:00`) >= today)
  .sort((first, second) => first.date.localeCompare(second.date))[0];
const songTypeLabels = { solo: 'Solo', collab: 'Collab', featured: 'Featured', other: 'Other' };
---
<Base>
  <section class="home-poster" aria-label="OSAD Records">
    <div class="poster-grain" aria-hidden="true"></div>
    <div class="poster-vinyl" aria-hidden="true">
      <span class="poster-label">RECORDS</span>
    </div>
    <h1 class="poster-wordmark">OSAD</h1>
    <div class="poster-tickets">
      {latest && (
        <a class="ticket" href={`/songs/${latest.id}`}>
          <span class="ticket-kicker">Phát hành mới nhất</span>
          <strong class="ticket-title">{latest.data.title}</strong>
          <span class="ticket-meta">
            {latest.data.type && <Badge kind="type" label={songTypeLabels[latest.data.type]} />}
            <Badge kind="year" label={String(latest.data.releaseDate.getFullYear())} />
          </span>
        </a>
      )}
      {next && (
        <a class="ticket" href={next.link || '/schedule'} target={next.link ? '_blank' : undefined} rel={next.link ? 'noopener' : undefined}>
          <span class="ticket-kicker">Sự kiện sắp tới</span>
          <strong class="ticket-title">{next.title}</strong>
          <span class="ticket-subtitle">
            {fmtDate(new Date(`${next.date.slice(0, 10)}T00:00:00`))}{next.place ? ` · ${next.place}` : ''}
          </span>
        </a>
      )}
    </div>
  </section>

  {recentSongs.length > 0 && (
    <div class="release-marquee" aria-label="Các bài hát mới nhất">
      <div class="marquee-track">
        {[0, 1].map(copy => (
          <div class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {recentSongs.map((song, index) => (
              <>
                <a href={`/songs/${song.id}`} tabindex={copy === 1 ? -1 : undefined}>{song.data.title}</a>
                {index < recentSongs.length - 1 && <span class="marquee-dot" aria-hidden="true">•</span>}
              </>
            ))}
            <span class="marquee-dot" aria-hidden="true">•</span>
          </div>
        ))}
      </div>
    </div>
  )}
</Base>

<style>
  .home-poster {
    position:relative;
    isolation:isolate;
    min-height:min(690px, calc(100svh - 72px));
    overflow:hidden;
    background:var(--amber);
  }
  .poster-grain {
    position:absolute;
    z-index:4;
    inset:0;
    opacity:.09;
    pointer-events:none;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E");
  }
  .poster-wordmark {
    position:relative;
    z-index:1;
    width:max-content;
    max-width:100%;
    margin:clamp(1.5rem, 4vw, 3.25rem) 0 0;
    color:var(--ink);
    font-family:Impact, Haettenschweiler, "Arial Narrow", sans-serif;
    font-size:clamp(7rem, 31vw, 25rem);
    font-weight:950;
    letter-spacing:-.075em;
    line-height:.78;
    white-space:nowrap;
  }
  .poster-vinyl {
    position:absolute;
    z-index:0;
    top:clamp(-90px, -7vw, -36px);
    right:clamp(-250px, -15vw, -90px);
    width:clamp(510px, 58vw, 790px);
    aspect-ratio:1;
    border:2px solid rgba(255,196,107,.12);
    border-radius:50%;
    background:
      radial-gradient(circle at center, var(--butter) 0 7%, var(--amber) 7.2% 7.7%, transparent 8% 100%),
      repeating-radial-gradient(circle at center, transparent 0 16px, rgba(255,196,107,.11) 17px 18px, transparent 19px 31px),
      radial-gradient(circle at 38% 31%, #3b2216 0, #24150e 67%, #160e09 100%);
    box-shadow:inset 0 0 0 8px rgba(0,0,0,.14), 0 14px 28px rgba(43,26,16,.12);
  }
  .poster-vinyl::before {
    position:absolute;
    inset:6%;
    border:2px solid rgba(232,115,26,.12);
    border-radius:50%;
    content:"";
  }
  .poster-vinyl::after {
    position:absolute;
    inset:12%;
    border:2px solid rgba(255,196,107,.1);
    border-radius:50%;
    content:"";
  }
  .poster-label {
    position:absolute;
    z-index:1;
    top:48%;
    left:0;
    padding:.1em .28em;
    background:var(--butter);
    box-shadow:6px 6px 0 var(--ink);
    color:var(--ink);
    font-family:Impact, Haettenschweiler, "Arial Narrow", sans-serif;
    font-size:clamp(1.5rem, 4.8vw, 3.8rem);
    font-weight:900;
    letter-spacing:.025em;
    transform:rotate(-7deg);
  }
  .poster-tickets {
    position:relative;
    z-index:2;
    display:flex;
    flex-wrap:wrap;
    gap:1.4rem;
    width:min(100% - 5rem, 1120px);
    margin:clamp(2.7rem, 5vw, 4.4rem) auto 3rem;
  }
  .ticket {
    display:flex;
    min-width:min(290px, 100%);
    min-height:100px;
    flex:0 1 310px;
    flex-direction:column;
    justify-content:center;
    gap:.15rem;
    padding:.8rem 1.3rem .8rem 1.5rem;
    border:1px solid var(--sand);
    border-left:3px dashed var(--amber);
    background:var(--cream);
    box-shadow:5px 5px 0 var(--ink);
    color:var(--ink);
    text-decoration:none;
  }
  .ticket:hover, .ticket:focus-visible { background:var(--paper); }
  .ticket-kicker { color:var(--muted); font-size:.78rem; }
  .ticket-title { font-size:1.28rem; line-height:1.25; }
  .ticket-meta { display:flex; gap:.4rem; margin-top:.2rem; }
  .ticket-subtitle { color:var(--muted); font-size:.8rem; font-weight:600; }
  .release-marquee {
    position:relative;
    z-index:3;
    width:calc(100% + 2rem);
    margin:0 -1rem 1.7rem;
    overflow:hidden;
    background:var(--ink);
    color:var(--cream);
    transform:rotate(-1.5deg);
  }
  .marquee-track {
    display:flex;
    width:max-content;
    animation:release-marquee-scroll 36s linear infinite;
  }
  .marquee-group { display:flex; flex:none; align-items:center; gap:2.4rem; padding:.72rem 1.2rem; }
  .marquee-group a { color:var(--cream); font-size:clamp(1rem, 2.2vw, 1.55rem); font-weight:800; text-decoration:none; white-space:nowrap; }
  .marquee-group a:hover, .marquee-group a:focus-visible { text-decoration:underline; }
  .marquee-dot { color:var(--amber); font-size:1.5rem; line-height:1; }
  .release-marquee:hover .marquee-track { animation-play-state:paused; }
  @keyframes release-marquee-scroll { to { transform:translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation:none; }
  }
  @media (max-width:700px) {
    .home-poster { min-height:600px; }
    .poster-wordmark { margin-top:4rem; font-size:clamp(6.5rem, 31vw, 13rem); }
    .poster-vinyl { top:6rem; right:-19rem; width:clamp(430px, 86vw, 600px); }
    .poster-label { top:49%; left:8%; }
    .poster-tickets { width:calc(100% - 2rem); margin:clamp(6rem, 30vw, 11rem) auto 2rem; gap:.8rem; }
    .ticket { min-height:92px; flex:1 1 100%; }
  }
  @media (max-width:420px) {
    .home-poster { min-height:600px; }
    .poster-wordmark { margin-top:4.4rem; font-size:clamp(6rem, 29vw, 7.5rem); }
    .poster-vinyl { top:7rem; right:-18.5rem; width:440px; }
    .poster-tickets { margin-top:8.5rem; }
    .ticket { min-width:0; }
    .release-marquee { margin-bottom:1rem; }
  }
</style>
