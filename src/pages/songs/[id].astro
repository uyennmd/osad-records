---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getSongs, fmtDate } from '../../lib/songs';
import { getPlatformConfig } from '../../lib/platforms';
export async function getStaticPaths() {
  const songs = await getSongs();
  return songs.map(song => ({ params: { id: song.id }, props: { song } }));
}
const { song } = Astro.props;
const { Content } = typeof song.body === 'string' ? await render(song) : { Content: null };
const d = song.data;
const hasLyrics = Boolean(d.lyrics?.trim() || song.body?.trim());

const typeLabels = {
  solo: 'Solo',
  guest: 'Có khách mời',
  featured: 'Tham gia feat',
  collab: 'Song ca / hợp tác',
  other: 'Khác',
};

const artistDisplay = (() => {
  const partners = [d.partner_1, d.partner_2, d.partner_3].filter(Boolean);
  const relatedArtists = [...new Set([d.mainArtist, ...partners].filter(Boolean))];
  switch (d.type) {
    case 'solo':
      return ['OSAD', ...relatedArtists].join(', ');
    case 'guest':
      return relatedArtists.length > 0 ? `OSAD ft. ${relatedArtists.join(', ')}` : 'OSAD';
    case 'featured':
      return d.mainArtist
        ? `${d.mainArtist} ft. OSAD${partners.length ? ` · ${partners.join(', ')}` : ''}`
        : ['OSAD', ...partners].join(', ');
    case 'collab':
      return ['OSAD', ...relatedArtists].join(' x ');
    case 'other':
      return ['OSAD', ...relatedArtists].join(', ');
    default:
      return relatedArtists.length ? relatedArtists.join(', ') : 'OSAD';
  }
})();
---
<Base title={d.title}>
  <article class="song-detail-shell">
    <div class="page-orb orb-one"></div>
    <div class="page-orb orb-two"></div>

    <p class="back-link"><a href="/songs">← Kho nhạc</a></p>
    <div class="head">
      <div class="cover">
        <div class="album-vinyl">
          {d.cover ? <img class="album-art" src={d.cover} alt={`Ảnh album ${d.album || d.title}`} /> : <span class="album-art-fallback"></span>}
        </div>
      </div>
      <div class="title-block">
        <p class="kicker">{song.cat}</p>
        <h1>{d.title}</h1>
      </div>
    </div>

    <section aria-labelledby="song-info-title">
      <h2 id="song-info-title">Thông tin bài hát</h2>
      <div class="song-info">
        <div class="info-item meta-card">
          <dt>Ngày phát hành</dt>
          <dd>{fmtDate(d.releaseDate)}</dd>
        </div>
        <div class="info-item meta-card">
          <dt>Album</dt>
          <dd>{d.album || 'Chưa cập nhật'}</dd>
        </div>
        <div class="info-item meta-card">
          <dt>Thể loại</dt>
          <dd>{d.type ? typeLabels[d.type] : 'Chưa cập nhật'}</dd>
        </div>
      </div>

      <div class="info-item artist-card">
        <dt>Nghệ sĩ</dt>
        <dd>{artistDisplay || 'Chưa cập nhật'}</dd>
      </div>
    </section>

    {d.credits.length > 0 && (
      <>
        <h2>Credit</h2>
        <div class="panel">
          <dl class="credits-list">
            {d.credits.map((credit) => (
              <div class="credit-item">
                <dt class="mono muted">{credit.role}</dt>
                <dd>{credit.name}</dd>
              </div>
            ))}
          </dl>
        </div>
      </>
    )}

    <h2>Nghe nhạc</h2>
    {d.links.length > 0 ? (
      <div class="stream-links">
        {d.links.map((l) => {
          const platform = getPlatformConfig(l.platform);
          return (
            <a
              class={`stream-link${platform.wordmark ? ' stream-link-wordmark' : ''}`}
              href={l.url}
              target="_blank"
              rel="noopener"
              style={`--brand:${platform.color};`}
              aria-label={l.platform}
            >
              <img src={platform.icon} alt="" aria-hidden="true" />
              {!platform.wordmark && <span>{l.platform}</span>}
            </a>
          );
        })}
      </div>
    ) : (
      <div class="empty">Chưa có link.</div>
    )}

    <h2>Lời bài hát</h2>
    <div class="lyrics-panel">
      {d.lyrics?.trim() ? <p class="lyrics-text">{d.lyrics}</p> : Content && hasLyrics ? <Content /> : <p class="lyrics-empty">Chưa có lời bài hát.</p>}
    </div>
  </article>

  <style>
    .song-detail-shell {
      position:relative;
      isolation:isolate;
      padding:clamp(1.2rem, 2vw, 2rem);
      border-radius:30px;
      background:linear-gradient(135deg, rgba(255,255,255,0.76), rgba(248,239,230,0.82));
      border:1px solid rgba(229, 202, 176, 0.9);
      box-shadow:0 28px 60px rgba(69, 41, 22, 0.08), inset 0 1px 0 rgba(255,255,255,0.75);
      overflow:hidden;
    }
    .page-orb {
      position:absolute;
      border-radius:50%;
      filter:blur(10px);
      opacity:0.6;
      z-index:-1;
      pointer-events:none;
    }
    .orb-one {
      width:260px;
      height:260px;
      background:radial-gradient(circle, rgba(232,115,26,0.18) 0%, rgba(232,115,26,0.04) 52%, transparent 100%);
      top:-80px;
      right:-40px;
    }
    .orb-two {
      width:220px;
      height:220px;
      background:radial-gradient(circle, rgba(174,115,74,0.14) 0%, rgba(174,115,74,0.02) 48%, transparent 100%);
      bottom:-60px;
      left:-50px;
    }
    .back-link {
      margin:0 0 1rem;
      font-size:0.95rem;
    }
    .back-link a {
      color:var(--ink);
      text-decoration:none;
      opacity:0.8;
    }
    .back-link a:hover { opacity:1; }
    .head { display:flex; gap:1.4rem; align-items:center; flex-wrap:wrap; margin:.5rem 0 1rem; }
    .title-block { flex:1 1 260px; }
    .song-info {
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:.8rem;
      margin:0 0 .8rem;
    }
    .info-item {
      min-width:0;
      padding:1rem 1.1rem;
      border:1.5px solid #EA580C;
      border-radius:16px;
      background:rgba(255,255,255,0.36);
      box-shadow:inset 0 0 0 1px rgba(234, 88, 12, 0.05), 0 8px 20px rgba(69,41,22,0.04);
    }
    .meta-card {
      min-height:108px;
    }
    .artist-card {
      min-height:128px;
      background:linear-gradient(180deg, rgba(255,255,255,0.52), rgba(255,247,241,0.7));
    }
    .info-item dt {
      margin-bottom:.35rem;
      color:var(--muted);
      font-family:var(--mono);
      font-size:.72rem;
      letter-spacing:.08em;
      text-transform:uppercase;
    }
    .info-item dd {
      margin:0;
      font-weight:700;
      line-height:1.6;
      overflow-wrap:anywhere;
      white-space:normal;
    }
    .artist-card dd {
      font-size:1.06rem;
      line-height:1.8;
    }
    .cover {
      width:180px;
      height:180px;
      flex:none;
      position:relative;
      display:grid;
      place-items:center;
    }
    .stream-links { display:flex; flex-wrap:wrap; gap:.8rem; }
    .credits-list {
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:1rem;
      margin:0;
    }
    .credit-item dt {
      margin-bottom:.25rem;
      font-size:.75rem;
      letter-spacing:.04em;
    }
    .credit-item dd { margin:0; font-weight:700; overflow-wrap:anywhere; }
    .lyrics-text {
      white-space:pre-wrap;
      line-height:1.7;
    }
    .stream-link {
      position:relative;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.55rem;
      min-height:48px;
      padding:.55rem .9rem;
      border:1.5px solid #EA580C;
      border-radius:12px;
      background:rgba(255,255,255,0.3);
      color:var(--ink);
      font-size:.9rem;
      font-weight:700;
      text-decoration:none;
      transition:background .24s ease, color .24s ease, box-shadow .24s ease, transform .24s ease;
      box-shadow:inset 0 0 0 1px rgba(234, 88, 12, 0.08), 0 6px 14px rgba(54, 31, 15, 0.05);
    }
    .stream-link img {
      width:24px;
      height:24px;
      flex:none;
      object-fit:contain;
      display:block;
      transition:filter .24s ease, transform .24s ease;
    }
    .stream-link-wordmark { min-width:168px; }
    .stream-link-wordmark img { width:132px; height:auto; }
    .stream-link:hover,
    .stream-link:focus-visible {
      background:#EA580C;
      color:white;
      box-shadow:0 10px 22px rgba(234, 88, 12, 0.24);
      transform:translateY(-2px);
    }
    .stream-link:hover img,
    .stream-link:focus-visible img {
      filter:brightness(0) invert(1);
    }
    .lyrics-panel {
      background:linear-gradient(180deg, rgba(255,255,255,0.52), rgba(255,250,246,0.7));
      border:1px solid rgba(235,217,194,0.9);
      border-radius:18px;
      padding:1.15rem 1.2rem;
      line-height:1.8;
      white-space:pre-line;
      box-shadow:inset 0 1px 0 rgba(255,255,255,0.6);
    }
    .lyrics-text, .lyrics-empty { margin:0; white-space:pre-wrap; }
    .lyrics-empty { color:var(--muted); font-style:italic; }
    @media (max-width:900px) {
      .song-info { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width:620px) {
      .song-info { grid-template-columns:1fr; }
      .cover { width:min(180px, 48vw); height:min(180px, 48vw); }
    }
  </style>
</Base>
