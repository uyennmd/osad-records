---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import Badge from '../../components/Badge.astro';
import VinylDisc from '../../components/VinylDisc.astro';
import { getSongs, fmtDate } from '../../lib/songs';
import { getArtistDisplay } from '../../lib/songs';
import { getPlatformConfig } from '../../lib/platforms';
export async function getStaticPaths() {
  const songs = await getSongs();
  return songs.map(song => ({ params: { id: song.id }, props: { song } }));
}
const { song } = Astro.props;
const { Content } = typeof song.body === 'string' ? await render(song) : { Content: null };
const d = song.data;
const hasLyrics = Boolean(d.lyrics?.trim() || song.body?.trim());
const artistDisplay = getArtistDisplay(d);
const releaseYear = d.releaseDate.getFullYear();
const typeLabels = { solo: 'Solo', collab: 'Collab', featured: 'Featured', other: 'Other' };
---
<Base title={d.title}>
  <article class="song-detail-shell">
    <p class="back-link"><a href="/songs">← Kho nhạc</a></p>
    <div class="head">
      <div class="cover">
        <VinylDisc cover={d.cover} alt={d.title} />
      </div>
      <div class="title-block">
        <p class="kicker">{song.cat}</p>
        <h1>{d.title}</h1>
        <div class="song-badges">
          {d.type && <Badge kind="type" label={typeLabels[d.type]} />}
          <Badge kind="year" label={String(releaseYear)} />
        </div>
      </div>
    </div>

    <section aria-labelledby="song-info-title">
      <h2 id="song-info-title">Thông tin bài hát</h2>
      <div class="song-info">
        <div class="info-item meta-card">
          <dt>Ngày phát hành</dt>
          <dd>{fmtDate(d.releaseDate)}</dd>
        </div>
        <div class="info-item meta-card">
          <dt>Album</dt>
          <dd>{d.album || 'Chưa cập nhật'}</dd>
        </div>
        <div class="info-item meta-card">
          <dt>Thể loại</dt>
          <dd>{d.type ? <Badge kind="type" label={typeLabels[d.type]} /> : 'Chưa cập nhật'}</dd>
        </div>
      </div>

      <div class="info-item artist-card">
        <dt>Nghệ sĩ</dt>
        <dd>{artistDisplay || 'Chưa cập nhật'}</dd>
      </div>
    </section>

    {d.credits.length > 0 && (
      <>
        <h2>Credit</h2>
        <div class="panel">
          <dl class="credits-list">
            {d.credits.map((credit) => (
              <div class="credit-item">
                <dt class="mono muted">{credit.role}</dt>
                <dd>{credit.name}</dd>
              </div>
            ))}
          </dl>
        </div>
      </>
    )}

    <h2>Nghe nhạc</h2>
    {d.links.length > 0 ? (
      <div class="stream-links">
        {d.links.map((l) => {
          const platform = getPlatformConfig(l.platform);
          return (
            <a
              class={`stream-link${platform.wordmark ? ' stream-link-wordmark' : ''}`}
              href={l.url}
              target="_blank"
              rel="noopener"
              style={`--brand:${platform.color};`}
              aria-label={l.platform}
            >
              <img src={platform.icon} alt="" aria-hidden="true" />
              {!platform.wordmark && <span>{l.platform}</span>}
            </a>
          );
        })}
      </div>
    ) : (
      <div class="empty">Chưa có link.</div>
    )}

    <h2>Lời bài hát</h2>
    <div class="lyrics-panel">
      {d.lyrics?.trim() ? <p class="lyrics-text">{d.lyrics}</p> : Content && hasLyrics ? <Content /> : <p class="lyrics-empty">Chưa có lời bài hát.</p>}
    </div>
    {d.notes?.trim() && (
      <>
        <h2>Ghi chú</h2>
        <div class="lyrics-panel"><p class="lyrics-text">{d.notes}</p></div>
      </>
    )}
  </article>

  <style>
    .song-detail-shell {
      padding:clamp(1.2rem, 2vw, 2rem);
    }
    .back-link {
      margin:0 0 1rem;
      font-size:0.95rem;
    }
    .back-link a {
      text-decoration:none;
    }
    .head { display:flex; gap:1.4rem; align-items:center; flex-wrap:wrap; margin:.5rem 0 1rem; }
    .title-block { flex:1 1 260px; }
    .song-badges { display:flex; flex-wrap:wrap; gap:.4rem; }
    .song-info {
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:.8rem;
      margin:0 0 .8rem;
    }
    .info-item {
      min-width:0;
      padding:1rem 1.1rem;
      border:1px solid var(--sand);
      border-radius:12px;
      background:var(--paper);
    }
    .meta-card {
      min-height:108px;
    }
    .artist-card {
      min-height:128px;
      background:var(--paper);
    }
    .info-item dt {
      margin-bottom:.35rem;
      color:var(--muted);
      font-family:var(--mono);
      font-size:.72rem;
      letter-spacing:.08em;
      text-transform:uppercase;
    }
    .info-item dd {
      margin:0;
      font-weight:700;
      line-height:1.6;
      overflow-wrap:anywhere;
      white-space:normal;
    }
    .artist-card dd {
      font-size:1.06rem;
      line-height:1.8;
    }
    .cover {
      width:180px;
      height:180px;
      flex:none;
      position:relative;
      display:grid;
      place-items:center;
    }
    .stream-links { display:flex; flex-wrap:wrap; gap:.8rem; }
    .credits-list {
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:1rem;
      margin:0;
    }
    .credit-item dt {
      margin-bottom:.25rem;
      font-size:.75rem;
      letter-spacing:.04em;
    }
    .credit-item dd { margin:0; font-weight:700; overflow-wrap:anywhere; }
    .lyrics-text {
      white-space:pre-wrap;
      line-height:1.7;
    }
    .stream-link {
      position:relative;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.55rem;
      min-height:48px;
      padding:.55rem .9rem;
      border:1.5px solid var(--amber);
      border-radius:12px;
      background:var(--paper);
      color:var(--ink);
      font-size:.9rem;
      font-weight:700;
      text-decoration:none;
      box-shadow:inset 0 0 0 1px rgba(234, 88, 12, 0.08), 0 6px 14px rgba(54, 31, 15, 0.05);
    }
    .stream-link img {
      width:24px;
      height:24px;
      flex:none;
      object-fit:contain;
      display:block;
    }
    .stream-link-wordmark { min-width:168px; }
    .stream-link-wordmark img { width:132px; height:auto; }
    .stream-link:hover,
    .stream-link:focus-visible {
      background:var(--amber);
      color:var(--ink);
      box-shadow:0 5px 12px rgba(43, 26, 16, 0.1);
    }
    .stream-link:hover img,
    .stream-link:focus-visible img {
      filter:brightness(.5);
    }
    .lyrics-panel {
      background:var(--paper);
      border:1px solid var(--sand);
      border-radius:12px;
      padding:1.15rem 1.2rem;
      line-height:1.8;
    }
    .lyrics-text, .lyrics-empty { margin:0; white-space:pre-wrap; }
    .lyrics-empty { color:var(--muted); font-style:italic; }
    @media (max-width:900px) {
      .song-info { grid-template-columns:repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width:620px) {
      .song-info { grid-template-columns:1fr; }
      .cover { width:min(180px, 48vw); height:min(180px, 48vw); }
    }
  </style>
</Base>
