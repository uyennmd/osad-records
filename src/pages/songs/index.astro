---
import { getCollection } from 'astro:content';
import Badge from '../../components/Badge.astro';
import ListToolbar from '../../components/ListToolbar.astro';
import Pagination from '../../components/Pagination.astro';
import VinylDisc from '../../components/VinylDisc.astro';
import Base from '../../layouts/Base.astro';
import { getArtistDisplay } from '../../lib/songs';

const songs = (await getCollection('songs')).sort(
  (first, second) => +second.data.releaseDate - +first.data.releaseDate,
);
const years = [...new Set(songs.map(song => song.data.releaseDate.getFullYear()))]
  .sort((first, second) => second - first);
const songsByYear = years.map(year => ({
  year,
  songs: songs.filter(song => song.data.releaseDate.getFullYear() === year),
}));
const types = [
  { value: 'solo', label: 'Solo' },
  { value: 'collab', label: 'Collab' },
  { value: 'featured', label: 'Featured' },
  { value: 'other', label: 'Other' },
].map(type => ({
  ...type,
  count: songs.filter(song => song.data.type === type.value).length,
}));
const selectedView = Astro.url.searchParams.get('view') === 'list' ? 'list' : 'grid';
---
<Base title="Bài hát">
  <section class="songs-page" data-list-root data-active-view={selectedView} data-total-items={songs.length} data-default-sort="newest" data-default-view="grid" data-page-sizes="grid:12,list:10">
    <div class="page-heading" data-list-scroll-target>
      <p class="kicker">Catalog</p>
      <h1>Bài hát</h1>
      <p class="page-description">{songs.length} bài hát, tìm hoặc lọc để thấy nhanh hơn</p>
    </div>
    <ListToolbar
      total={songs.length}
      typeOptions={types}
      years={years}
      searchPlaceholder="Tìm tên bài, album, nghệ sĩ..."
      showView
      view={selectedView}
      pageSize={selectedView === 'list' ? 10 : 12}
    />
    <div class="list-container">
      <div class={`song-groups ${selectedView === 'list' ? 'list-view' : 'grid-view'}`} data-list-items data-active-view={selectedView}>
        {songsByYear.map(({ year, songs: yearSongs }) => (
          <section class="song-year-group" data-year-group data-year={year}>
            <h2 class="song-year-heading" data-list-year-heading={year}>{year}</h2>
            <div class="song-year-items" data-year-items={year}>
              {yearSongs.map(song => {
                const data = song.data;
                const releaseYear = data.releaseDate.getFullYear();
                const artist = getArtistDisplay(data);
                const searchable = [data.title, data.album, artist].filter(Boolean).join(' ');
                const typeLabel = types.find(type => type.value === data.type)?.label ?? '';
                return (
                  <article
                    class="song-card"
                    data-list-item
                    data-date={data.releaseDate.toISOString().slice(0, 10)}
                    data-year={releaseYear}
                    data-type={data.type ?? ''}
                    data-title={data.title}
                    data-search={searchable}
                  >
                    <div class="song-grid-content">
                      <a href={`/songs/${song.id}`} class="cover-link" aria-label={`Xem bài hát ${data.title}`}>
                        <div class="cover-art">
                          <VinylDisc cover={data.cover} alt={data.title} />
                        </div>
                      </a>
                      <div class="song-grid-meta">
                        <h3 class="song-grid-title"><a href={`/songs/${song.id}`}>{data.title}</a></h3>
                        <p class="song-grid-artist" title={artist}>{artist || '\u00a0'}</p>
                        <div class="song-grid-topline">
                          {typeLabel && <Badge kind="type" label={typeLabel} />}
                          <Badge kind="year" label={String(releaseYear)} />
                        </div>
                      </div>
                    </div>
                    <div class="song-list-content">
                      <a href={`/songs/${song.id}`} class="list-cover cover-link" aria-label={`Xem bài hát ${data.title}`}>
                        <VinylDisc cover={data.cover} alt={data.title} />
                      </a>
                      <div class="list-song-copy">
                        <h3><a href={`/songs/${song.id}`}>{data.title}</a></h3>
                        {artist && <p class="song-artist">{artist}</p>}
                      </div>
                      <div class="list-song-type">{typeLabel && <Badge kind="type" label={typeLabel} />}</div>
                      <div class="list-song-year"><Badge kind="year" label={String(releaseYear)} /></div>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
    {songs.length === 0 ? (
      <div class="empty">Chưa có bài hát nào.</div>
    ) : (
      <div class="empty empty-filtered" data-list-empty hidden>
        <p>Không có kết quả</p>
        <button type="button" class="btn" data-clear-filters>Xóa bộ lọc</button>
      </div>
    )}
    <Pagination totalItems={songs.length} pageSize={selectedView === 'list' ? 10 : 12} />
  </section>

  <style>
    .page-heading .kicker { margin-bottom:.45rem; }
    .page-heading h1 { margin-bottom:.25rem; }
    .page-description { margin:0; color:var(--muted); font-size:.88rem; }
    .songs-page .type-filters { flex:0 1 auto; }
    .list-container { border:1px solid var(--sand); border-radius:12px; }
    .songs-page[data-active-view="grid"] .list-container { border:0; border-radius:0; }
    .song-groups.grid-view { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:14px; border:0; overflow:visible; }
    .song-groups.grid-view .song-year-heading { display:none; }
    .song-year-group { min-width:0; }
    .song-groups.grid-view .song-year-group { display:contents; }
    .song-year-items { display:contents; }
    .song-card { min-width:0; background:var(--paper); border:1px solid var(--sand); }
    .song-grid-content { padding:12px; }
    .song-groups.grid-view .song-card { display:flex; align-items:stretch; border-radius:12px; overflow:hidden; }
    .song-groups.grid-view .song-grid-content { display:flex; width:100%; flex-direction:column; }
    .cover-link { display:block; text-decoration:none; }
    .cover-art { display:grid; place-items:center; aspect-ratio:1; }
    .song-grid-content .album-vinyl { width:min(100%, 240px); }
    .song-grid-meta { display:flex; min-width:0; flex:1; flex-direction:column; align-items:center; padding-top:6px; }
    .song-grid-topline { display:flex; min-width:0; align-items:center; justify-content:center; gap:8px; margin-top:auto; padding-top:12px; }
    .song-grid-meta h3, .list-song-copy h3 { margin:0; font-size:.9rem; line-height:1.35; }
    .song-grid-title { min-width:0; max-width:100%; display:-webkit-box; overflow:hidden; font-weight:700; line-height:1.2; text-align:center; overflow-wrap:anywhere; -webkit-box-orient:vertical; -webkit-line-clamp:2; line-clamp:2; }
    .song-grid-meta h3 a, .list-song-copy h3 a { color:var(--ink); text-decoration:none; }
    .song-grid-meta h3 a:hover, .list-song-copy h3 a:hover { color:var(--amber-d); }
    .song-artist { margin:.1rem 0 .35rem; color:var(--muted); font-size:.75rem; line-height:1.35; }
    .song-grid-artist { width:100%; margin:0; overflow:hidden; color:var(--muted); font-size:.75rem; line-height:1.15rem; text-align:center; text-overflow:ellipsis; white-space:nowrap; }
    .song-grid-topline .badge { flex:none; white-space:nowrap; }
    .song-groups.list-view { display:block; }
    .song-groups.list-view .song-year-group { display:block; }
    .song-year-heading { position:sticky; z-index:2; top:0; margin:0; padding:.42rem .8rem; border-bottom:1px solid var(--sand); background:var(--cream); color:var(--amber-d); font-size:1rem; }
    .song-groups.list-view .song-year-items { display:block; }
    .song-groups.list-view .song-card { border:0; border-bottom:1px solid var(--sand); }
    .song-groups.list-view .song-card:last-child { border-bottom:0; }
    .song-groups.list-view .song-grid-content { display:block; }
    .song-list-content { display:none; }
    .song-groups.list-view .song-grid-content { display:none; }
    .song-groups.list-view .song-list-content { display:flex; min-height:64px; align-items:center; gap:12px; padding:8px 12px; }
    .list-cover { width:56px; flex:none; }
    .list-cover .album-vinyl { width:56px; box-shadow:0 3px 6px rgba(43,26,16,.3); }
    .list-song-copy { min-width:0; flex:1 1 auto; }
    .list-song-copy h3 { overflow-wrap:anywhere; }
    .list-song-type, .list-song-year { width:78px; flex:none; text-align:center; }
    .empty-filtered { margin-top:1rem; }
    .empty-filtered p { margin:0 0 .8rem; }
    @media (max-width:900px) {
      .song-groups.grid-view { grid-template-columns:repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width:640px) {
      .song-groups.grid-view { grid-template-columns:repeat(2, minmax(0, 1fr)); gap:10px; }
      .song-grid-content { padding:8px; }
      .song-grid-meta h3 { font-size:.82rem; }
      .song-groups.list-view .song-list-content { gap:8px; padding:8px; }
      .list-song-type, .list-song-year { width:auto; }
    }
  </style>
</Base>
