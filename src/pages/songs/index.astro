---
import Base from '../../layouts/Base.astro';
import { getSongs, fmtDate } from '../../lib/songs';
const songs = (await getSongs()).reverse();
---
<Base title="Bài hát">
  <p class="kicker">Catalog</p>
  <h1>Bài hát</h1>
  {songs.length === 0 && <div class="empty">Chưa có bài hát nào.</div>}
  <div class="cards">
    {songs.map((s) => {
      const year = new Date(s.data.releaseDate).getFullYear();
      return (
        <article class="song-card">
          <a href={`/songs/${s.id}`} class="cover-link" aria-label={`Xem bài hát ${s.data.title}`}>
            <div class="cover-art">
              <div class="album-vinyl">
                {s.data.cover ? <img class="album-art" src={s.data.cover} alt={`Ảnh album ${s.data.album || s.data.title}`} loading="lazy" /> : <span class="album-art-fallback"></span>}
              </div>
            </div>
          </a>

          <div class="meta">
            <h3><a href={`/songs/${s.id}`}>{s.data.title}</a></h3>
            {s.data.album && <p class="artist">{s.data.album}</p>}
            <p class="year">{year}</p>
          </div>
        </article>
      );
    })}
  </div>

  <style>
    .cards {
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:1.6rem;
      align-items:stretch;
    }

    .song-card {
      background:linear-gradient(180deg, rgba(255,255,255,0.68), rgba(255,247,240,0.92));
      border:1px solid rgba(206, 170, 132, 0.8);
      border-radius:24px;
      overflow:hidden;
      box-shadow:0 18px 38px rgba(63, 39, 20, 0.12);
      transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;
      padding:1rem;
    }

    .song-card:hover {
      transform:translateY(-4px);
      border-color:rgba(194, 93, 12, 0.7);
      box-shadow:0 24px 44px rgba(63, 39, 20, 0.16);
    }

    .cover-link {
      display:block;
      text-decoration:none;
    }

    .cover-art {
      position:relative;
      display:flex;
      align-items:center;
      justify-content:center;
      aspect-ratio:1;
    }

    .meta {
      padding:1rem 0 0;
      text-align:center;
    }

    .meta h3 {
      margin:0 0 .35rem;
      font-size:1.32rem;
      line-height:1.3;
    }

    .meta h3 a {
      color:var(--ink);
      text-decoration:none;
    }

    .meta h3 a:hover {
      color:var(--amber-d);
    }

    .artist, .year {
      margin:0;
      color:var(--muted);
      font-size:.82rem;
      line-height:1.5;
    }

    .year {
      margin-top:.15rem;
    }

    @media (max-width:980px) {
      .cards {
        grid-template-columns:repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width:560px) {
      .cards {
        grid-template-columns:1fr;
      }
    }
  </style>
</Base>
