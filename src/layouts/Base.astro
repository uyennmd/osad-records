---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
const { title = 'OSAD Records' } = Astro.props;
const path = Astro.url.pathname;
const nav = [['/', 'Trang chủ'], ['/profile', 'Giới thiệu'], ['/timeline', 'Hành trình'], ['/songs', 'Bài hát'], ['/schedule', 'Lịch trình']];
const on = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={path === '/' ? '#E8731A' : '#FFF6EA'} />
    <title>{title === 'OSAD Records' ? title : `${title} · OSAD Records`}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body class={path === '/' ? 'home-page' : 'inner-page'}>
    <div class="shell">
      <header class="site-header">
        <a class="logo" href="/" aria-label="OSAD Records - Trang chủ">
          <span class="disc" aria-hidden="true"></span>
          <span>OSAD Records</span>
        </a>
        <div class="nav-menu">
          <button class="menu-toggle" type="button" aria-label="Mở menu điều hướng" aria-expanded="false" aria-controls="primary-navigation">
            <span class="menu-icon" aria-hidden="true"></span>Menu
          </button>
          <nav class="top-nav" id="primary-navigation" aria-label="Điều hướng chính">
            {nav.map(([href, label]) => (
              <a href={href} aria-current={on(href) ? 'page' : undefined}>{label}</a>
            ))}
          </nav>
        </div>
      </header>
      <div>
        <main>
          <slot />
          <p class="foot">Bản quyền ca khúc, hình ảnh và bản ghi thuộc về nghệ sĩ và đơn vị sở hữu tương ứng. OSAD Records là trang lưu giữ kỷ niệm của fan, không đại diện cho các bên liên quan.</p>
        </main>
      </div>
    </div>
    <script>
      const initializedMenus = new WeakSet<HTMLElement>();

      function initializeNavigationMenus() {
        document.querySelectorAll<HTMLElement>('.nav-menu').forEach(menu => {
          if (initializedMenus.has(menu)) return;
          initializedMenus.add(menu);

          const button = menu.querySelector<HTMLButtonElement>('.menu-toggle');
          if (!button) return;

          const setOpen = (open: boolean) => {
            menu.classList.toggle('is-open', open);
            button.setAttribute('aria-expanded', String(open));
            button.setAttribute('aria-label', open ? 'Đóng menu điều hướng' : 'Mở menu điều hướng');
          };

          button.addEventListener('click', () => {
            setOpen(button.getAttribute('aria-expanded') !== 'true');
          });
          menu.querySelectorAll<HTMLAnchorElement>('.top-nav a').forEach(link => {
            link.addEventListener('click', () => setOpen(false));
          });
          menu.addEventListener('keydown', event => {
            if (event.key === 'Escape') {
              setOpen(false);
              button.focus();
            }
          });
        });
      }

      initializeNavigationMenus();
      document.addEventListener('astro:page-load', initializeNavigationMenus);
    </script>
  </body>
</html>
