---
interface Props {
  cover?: string;
  alt: string;
}

const { cover, alt } = Astro.props;
const isYoutubeCover = cover?.startsWith('https://img.youtube.com/vi/') ?? false;
---
<div class="album-vinyl">
  <span class="vinyl-grooves" aria-hidden="true"></span>
  {cover ? (
    <img
      class="album-art"
      src={cover}
      alt={alt}
      loading="lazy"
      decoding="async"
      onerror={isYoutubeCover ? "if (this.src.includes('/maxresdefault.jpg')) { this.src = this.src.replace('/maxresdefault.jpg', '/mqdefault.jpg'); } else { this.hidden = true; this.nextElementSibling.hidden = false; }" : "this.hidden = true; this.nextElementSibling.hidden = false;"}
    />
  ) : (
    <span class="album-art-fallback"></span>
  )}
  {cover && <span class="album-art-fallback" hidden></span>}
  <span class="vinyl-light" aria-hidden="true"></span>
  <span class="vinyl-center-hole" aria-hidden="true"></span>
</div>
